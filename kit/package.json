{
  "name": "nap-page",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "shot": "node scripts/shot.mjs",
    "build:kitchen": "vite build --mode kitchen --outDir dist-kitchen",
    "build:dashboard": "vite build --mode dashboard --outDir dist-dashboard",
    "build:slides": "tsc -b && vite build --mode slides"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@pierre/diffs": "^1.6.4",
    "@pierre/highlights": "^0.4.0",
    "@tailwindcss/vite": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "torph": "^0.1.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "sideEffects": [
    "*.css"
  ]
