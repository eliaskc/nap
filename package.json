{
  "name": "nap",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "env -u npm_execpath -u npm_config_user_agent CI=1 CLOUDFLARE_API_TOKEN=local node node_modules/alchemy/bin/cli.js dev --stage local",
    "dev:remote": "alchemy dev --profile ${ALCHEMY_PROFILE:-nap}",
    "infra:login": "alchemy profile edit --profile ${ALCHEMY_PROFILE:-nap}",
    "test": "node --test 'tests/*.test.mjs' 'instance/extensions/*/*.test.mjs'",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "deploy": "bun scripts/infra/run.mjs deploy",
    "deploy:adopt": "bun scripts/infra/run.mjs adopt",
    "plan": "bun scripts/infra/run.mjs plan",
    "infra:inventory": "bun scripts/infra/inventory.mjs",
    "logs": "alchemy logs --stage prod --profile ${ALCHEMY_PROFILE:-nap}",
    "test:http": "node scripts/agent-publish/test-local.mjs && node scripts/agent-api/test-local.mjs && node scripts/channel-servers/test-local.mjs",
    "test:voice": "node scripts/voice/test-browser.mjs",
    "test:sources": "node scripts/sources/test-remote.mjs",
    "test:apps": "node scripts/apps/test-testflight.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@base-ui/react": "^1.5.0",
    "@chenglou/pretext": "^1.0.0",
    "@cloudflare/containers": "^0.3.7",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-start": "^1.168.25",
    "alchemy": "2.0.0-beta.85",
    "aws4fetch": "^1.0.20",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.1",
    "effect": "4.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.18.0",
    "motion": "^14.9.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "torph": "^0.1.3",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare-runtime": "2.0.0-beta.85",
    "@cloudflare/workers-types": "5.20260822.1",
    "@effect/platform-bun": "4.1.1",
    "@effect/platform-node": "4.1.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.14"
  }
}
