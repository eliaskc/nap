#!/bin/sh
# Writes the launcher's registry from Apps/*, then generates the Xcode project with Tuist. Both
# outputs are gitignored: run this after every pull.
set -eu
cd "$(dirname "$0")/.."

field() { plutil -extract "$2" raw -o - "$1" 2>/dev/null || true; }
swift_string() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

rm -rf Generated
mkdir -p Generated/Launcher
registry=Generated/Launcher/Registry.swift
{
  echo "// Generated by scripts/generate. Do not edit."
  echo "import SwiftUI"
  for dir in Apps/*/; do
    slug=$(basename "$dir")
    [ -f "$dir/app.json" ] || continue
    echo "import App_$(echo "$slug" | tr - _)"
  done
  echo ""
  echo "@MainActor"
  echo "enum Registry {"
  echo "  static let apps: [AppEntry] = ["
  for dir in Apps/*/; do
    slug=$(basename "$dir")
    json="$dir/app.json"
    [ -f "$json" ] || continue
    module="App_$(echo "$slug" | tr - _)"
    title=$(swift_string "$(field "$json" title)")
    summary=$(swift_string "$(field "$json" summary)")
    site=$(swift_string "$(field "$json" site)")
    echo "    AppEntry(slug: \"$slug\", title: \"${title:-$slug}\", summary: \"$summary\", site: \"$site\", view: { AnyView($module.AppView()) }),"
  done
  echo "  ]"
  echo "}"
} > "$registry"

# Project.swift reads Apps/ when Tuist evaluates it, and Tuist caches that result by the
# manifest's own content. A TUIST_ variable is part of the cache key, so pass one that changes
# whenever an app is added, removed, or its app.json changes.
TUIST_APPS=$( (ls Apps; cat Apps/*/app.json) | shasum | cut -c1-16)
export TUIST_APPS

if command -v mise >/dev/null 2>&1; then
  mise exec -- tuist generate --no-open
else
  tuist generate --no-open
fi
