#!/bin/sh
# Builds the launcher for iPhone without signing and zips it: build/launcher.zip.
# Nap signs the build when you publish it. Release: Swift's optimizer makes SwiftUI noticeably
# smoother on a phone than an unoptimized Debug build.
set -eu
cd "$(dirname "$0")/.."

./scripts/generate >/dev/null
mkdir -p .build
xcodebuild build \
  -project NapApps.xcodeproj \
  -scheme Launcher \
  -configuration Release \
  -sdk iphoneos \
  -destination 'generic/platform=iOS' \
  -derivedDataPath .build/DerivedData \
  CODE_SIGNING_ALLOWED=NO \
  -quiet >.build/xcodebuild.log 2>&1 || {
  grep -E "error:" .build/xcodebuild.log | sort -u >&2
  echo "Build failed. Full log: .build/xcodebuild.log" >&2
  exit 1
}

mkdir -p build
rm -f build/launcher.zip
ditto -c -k --keepParent .build/DerivedData/Build/Products/Release-iphoneos/Nap.app build/launcher.zip
echo build/launcher.zip
