#!/bin/sh
# Writes the launcher's registry and each standalone app's entry point from Prototypes/*, then
# generates the Xcode project with Tuist. Both outputs are gitignored: run this after every pull.
set -eu
cd "$(dirname "$0")/.."

field() { plutil -extract "$2" raw -o - "$1" 2>/dev/null || true; }
swift_string() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

rm -rf Generated
mkdir -p Generated/Launcher
registry=Generated/Launcher/Registry.swift
{
  echo "// Generated by scripts/generate. Do not edit."
  echo "import SwiftUI"
  for dir in Prototypes/*/; do
    slug=$(basename "$dir")
    [ -f "$dir/prototype.json" ] || continue
    echo "import Proto_$(echo "$slug" | tr - _)"
  done
  echo ""
  echo "@MainActor"
  echo "enum Registry {"
  echo "  static let prototypes: [PrototypeEntry] = ["
  for dir in Prototypes/*/; do
    slug=$(basename "$dir")
    json="$dir/prototype.json"
    [ -f "$json" ] || continue
    module="Proto_$(echo "$slug" | tr - _)"
    title=$(swift_string "$(field "$json" title)")
    summary=$(swift_string "$(field "$json" summary)")
    echo "    PrototypeEntry(slug: \"$slug\", title: \"${title:-$slug}\", summary: \"$summary\", view: { AnyView($module.PrototypeView()) }),"
    if [ "$(field "$json" standalone)" = "true" ]; then
      mkdir -p "Generated/Standalone/$slug"
      cat > "Generated/Standalone/$slug/App.swift" <<SWIFT
// Generated by scripts/generate. Do not edit.
import SwiftUI
import $module

@main
struct StandaloneApp: App {
  var body: some Scene {
    WindowGroup { $module.PrototypeView() }
  }
}
SWIFT
    fi
  done
  echo "  ]"
  echo "}"
} > "$registry"

if command -v mise >/dev/null 2>&1; then
  mise exec -- tuist generate --no-open
else
  tuist generate --no-open
fi
