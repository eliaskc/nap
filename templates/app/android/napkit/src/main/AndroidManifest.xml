<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application>
    <!-- Starts NapKit with the app, before any activity: Nap needs the app's context. It also
         starts Firebase, with the Nap's project (NapPush). -->
    <provider
      android:name="nap.kit.NapStarter"
      android:authorities="${applicationId}.napkit"
      android:exported="false" />

    <!-- Notifications (NapPush). There is no google-services.json: NapKit starts Firebase itself
         with the project Nap names, so Firebase's own starter is removed, and its messaging
         waits for NapKit before it gets a token. -->
    <provider
      android:name="com.google.firebase.provider.FirebaseInitProvider"
      android:authorities="${applicationId}.firebaseinitprovider"
      tools:node="remove" />
    <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
    <meta-data
      android:name="com.google.firebase.messaging.default_notification_channel_id"
      android:value="nap" />
    <meta-data
      android:name="com.google.firebase.messaging.default_notification_icon"
      android:resource="@drawable/nap_notification" />
    <service
      android:name="nap.kit.NapMessagingService"
      android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
