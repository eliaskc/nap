#!/bin/sh
# Takes the handwriting code from the web games (dle), so the tablet and the iPad behave alike:
# the network's weights (public/pen/letters.bin, run by backend/hwr.go) and the geometry around
# it (scratch-outs, words written side by side, from src/lib/pen/recognizer.ts), compiled for
# QML into launcher/ui/nap/pen/pencore.js.
#   scripts/sync-pen <dle checkout>
set -eu
cd "$(dirname "$0")/.."
dle=${1:?usage: scripts/sync-pen <dle checkout>}
cp "$dle/public/pen/letters.bin" launcher/pen/letters.bin
entry=$(mktemp -d -t pen)/pen.ts
cat > "$entry" <<TS
export { isScratch, splitWord, ranked, LETTERS } from "$dle/src/lib/pen/recognizer"
TS
{
  printf '.pragma library\n.import "../polyfills.js" as Polyfills\n'
  printf '// Generated by scripts/sync-pen from dle'"'"'s src/lib/pen/recognizer.ts (%s). Do not edit.\n' "$(git -C "$dle" rev-parse --short HEAD 2>/dev/null || echo unknown)"
  npx -y esbuild@0.25.10 "$entry" --bundle --format=iife --global-name=Core --target=es2020 --log-level=warning | sed -e '/^  \/\/ .*pen\.ts$/d'
} > launcher/ui/nap/pen/pencore.js
rm -f "$entry"
echo "launcher/ui/nap/pen/pencore.js and launcher/pen/letters.bin updated from $dle"
